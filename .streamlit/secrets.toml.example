[xano]
base_url = "https://<workspace>.xano.io/api:<queue-management-group>"
login_url = "https://<workspace>.xano.io/api:<authentication-group>/auth/login"
me_url = "https://<workspace>.xano.io/api:<authentication-group>/auth/me"
queues_url = "https://<workspace>.xano.io/api:<queue-management-group>/totem/queues"
issue_url = "https://<workspace>.xano.io/api:<queue-management-group>/totem/issue"
tracking_url = "https://<workspace>.xano.io/api:<queue-management-group>/tracking"
totem_email = "totem@filasmart.com"
totem_password = "<configure-local-test-password>"

[tv_display]
feed_url = "https://<workspace>.xano.io/api:<queue-management-group>/tv/feed"
credential = "<configure-local-display-credential>"

[analytics]
login_url = "https://<workspace>.xano.io/api:<authentication-group>/auth/login"
options_url = "https://<workspace>.xano.io/api:<queue-management-group>/analytics/options"
report_url = "https://<workspace>.xano.io/api:<queue-management-group>/analytics/report"

[xano_seed]
endpoint_url = "https://<workspace>.xano.io/api:<queue-management-group>/setup/seed"
environment = "test"
bootstrap_secret = "<configure-out-of-band>"
admin_password = "<local-test-only-password>"
